
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Paylo Admin</title>


    <!-- =====================================================
         GOOGLE FONT
    ====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- =====================================================
         ADMIN CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-common.css"
          asp-append-version="true" />


    <!-- Page specific CSS -->

    @RenderSection("Styles", required: false)

</head>


<body>

    <div class="admin-wrapper">


        <!-- =================================================
             SIDEBAR
        ================================================== -->

        <aside class="sidebar"
               id="sidebar">


            <!-- Logo -->

            <div class="sidebar-logo">

                <a href="@Url.Action("Dashboard", "Admin")">

                    <img src="~/images/paylo_logo.png"
                         alt="Paylo Logo" />

                </a>


                <button class="mobile-close"
                        id="mobileClose">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!-- Navigation -->

            <div class="sidebar-content">

                <div class="menu-title">
                    MAIN MENU
                </div>


                <ul class="sidebar-menu">


                    <!-- Dashboard -->

                    <li>

                        <a href="@Url.Action("Dashboard", "Admin")"
                           class="@(currentAction == "Dashboard" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-grid-1x2-fill"></i>

                            </span>

                            <span>
                                Dashboard
                            </span>

                        </a>

                    </li>


                    <!-- Transactions -->

                    <li>

                        <a href="@Url.Action("Transactions", "Admin")"
                           class="@(currentAction == "Transactions" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-arrow-left-right"></i>

                            </span>

                            <span>
                                Transactions
                            </span>

                        </a>

                    </li>


                    <!-- Recharge -->

                    <li>

                        <a href="@Url.Action("RechargeBills", "Admin")"
                           class="@(currentAction == "RechargeBills" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-phone-fill"></i>

                            </span>

                            <span>
                                Recharge & Bills
                            </span>

                        </a>

                    </li>


                    <!-- Users -->

                    <li>

                        <a href="@Url.Action("Users", "Admin")"
                           class="@(currentAction == "Users" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-people-fill"></i>

                            </span>

                            <span>
                                Users
                            </span>

                        </a>

                    </li>


                    <!-- Reports -->

                    <li>

                        <a href="@Url.Action("Reports", "Admin")"
                           class="@(currentAction == "Reports" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-bar-chart-fill"></i>

                            </span>

                            <span>
                                Reports
                            </span>

                        </a>

                    </li>


                    <!-- Commission -->

                    <li>

                        <a href="@Url.Action("Commission", "Admin")"
                           class="@(currentAction == "Commission" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-percent"></i>

                            </span>

                            <span>
                                Commission
                            </span>

                        </a>

                    </li>


                    <!-- Support -->

                    <li>

                        <a href="@Url.Action("Support", "Admin")"
                           class="@(currentAction == "Support" ? "active" : "")">

                            <span class="menu-icon">

                                <i class="bi bi-headset"></i>

                            </span>

                            <span>
                                Support Tickets
                            </span>

                            <span class="menu-badge">
                                5
                            </span>

                        </a>

                    </li>

                </ul>


                <!-- Account -->

                <div class="menu-title second-menu">
                    ACCOUNT
                </div>


                <ul class="sidebar-menu">


                    <!-- Notifications -->

                    <li>

                        <a href="@Url.Action("Notifications", "Admin")">

                            <span class="menu-icon">

                                <i class="bi bi-bell-fill"></i>

                            </span>

                            <span>
                                Notifications
                            </span>

                            <span class="menu-badge notification">
                                12
                            </span>

                        </a>

                    </li>


                    <!-- Settings -->

                    <li>

                        <a href="@Url.Action("Settings", "Admin")">

                            <span class="menu-icon">

                                <i class="bi bi-gear-fill"></i>

                            </span>

                            <span>
                                Settings
                            </span>

                        </a>

                    </li>


                    <!-- Profile -->

                    <li>

                        <a href="@Url.Action("Profile", "Admin")">

                            <span class="menu-icon">

                                <i class="bi bi-person-circle"></i>

                            </span>

                            <span>
                                Profile
                            </span>

                        </a>

                    </li>


                    <!-- Logout -->

                    <li>

                        <a href="@Url.Action("Logout", "Admin")"
                           class="logout-link">

                            <span class="menu-icon">

                                <i class="bi bi-box-arrow-right"></i>

                            </span>

                            <span>
                                Logout
                            </span>

                        </a>

                    </li>

                </ul>

            </div>


            <!-- =================================================
                 UPGRADE CARD
            ================================================== -->

            <div class="upgrade-card">

                <div class="upgrade-icon">
                    🚀
                </div>

                <h4>
                    Upgrade to Pro
                </h4>

                <p>
                    Unlock more features and get better insights.
                </p>

                <button>
                    Upgrade Now
                </button>

            </div>


            <!-- Footer -->

            <div class="sidebar-footer">

                © 2026 Paylo

                <br />

                All rights reserved.

            </div>

        </aside>


        <!-- =================================================
             SIDEBAR OVERLAY
        ================================================== -->

        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>


        <!-- =================================================
             MAIN CONTENT
        ================================================== -->

        <main class="main-content">


            <!-- =================================================
                 TOP HEADER
            ================================================== -->

            <header class="top-header">


                <div class="header-left">

                    <button class="sidebar-toggle"
                            id="sidebarToggle">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <!-- Header Search -->

                <div class="header-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           placeholder="Search here..." />

                </div>


                <!-- Header Right -->

                <div class="header-right">


                    <!-- Notification -->

                    <button class="header-icon">

                        <i class="bi bi-bell"></i>

                        <span class="notification-dot">
                            12
                        </span>

                    </button>


                    <!-- Profile -->

                    <div class="profile-dropdown">

                        <div class="profile-image">

                            <i class="bi bi-person-fill"></i>

                        </div>


                        <div class="profile-info">

                            <strong>
                                Admin User
                            </strong>

                            <small>
                                Super Admin
                            </small>

                        </div>


                        <i class="bi bi-chevron-down"></i>

                    </div>

                </div>

            </header>


            <!-- =================================================
                 PAGE CONTENT
            ================================================== -->

            <section class="page-content">

                @RenderBody()

            </section>

        </main>

    </div>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->


    <!-- jQuery MUST COME FIRST -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- Bootstrap -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =====================================================
         COMMON TABLE JS

         Search
         Sorting
         Pagination
         Page Size
         Status Filter
         Clear Search
         Excel Export
    ====================================================== -->

@*     <script src="~/js/common/commonTable.js"
            asp-append-version="true"></script>
 *@
    <script src="~/js/commonpage.js" asp-append-version="true"></script>
    <!-- =====================================================
         ADMIN LAYOUT JS
    ====================================================== -->

    <script>

        // =====================================================
        // SIDEBAR
        // =====================================================

        const sidebar =
            document.getElementById("sidebar");

        const sidebarToggle =
            document.getElementById("sidebarToggle");

        const mobileClose =
            document.getElementById("mobileClose");

        const sidebarOverlay =
            document.getElementById("sidebarOverlay");


        if (sidebarToggle) {

            sidebarToggle.addEventListener(
                "click",
                function () {

                    sidebar.classList.toggle("show");

                    sidebarOverlay.classList.toggle("show");

                }
            );

        }


        if (mobileClose) {

            mobileClose.addEventListener(
                "click",
                function () {

                    sidebar.classList.remove("show");

                    sidebarOverlay.classList.remove("show");

                }
            );

        }


        if (sidebarOverlay) {

            sidebarOverlay.addEventListener(
                "click",
                function () {

                    sidebar.classList.remove("show");

                    sidebarOverlay.classList.remove("show");

                }
            );

        }


        // =====================================================
        // COUNTER ANIMATION
        // =====================================================

        document
            .querySelectorAll(".counter")
            .forEach(function (counter) {

                const target =
                    parseInt(
                        counter.innerText
                            .replace(/,/g, "")
                    ) || 0;


                let count = 0;


                const increment =
                    target / 60;


                const updateCounter = () => {

                    count += increment;


                    if (count < target) {

                        counter.innerText =
                            Math.floor(
                                count
                            ).toLocaleString();


                        requestAnimationFrame(
                            updateCounter
                        );

                    }
                    else {

                        counter.innerText =
                            target.toLocaleString();

                    }

                };


                updateCounter();

            });

    </script>


    <!-- =====================================================
         PAGE SPECIFIC JS

         Example:

         CreditCardPercentage.cshtml
         ↓
         creditcardpercentage.js

         Commission.cshtml
         ↓
         commission.js
    ====================================================== -->

    @RenderSection("Scripts", required: false)

</body>

</html>

