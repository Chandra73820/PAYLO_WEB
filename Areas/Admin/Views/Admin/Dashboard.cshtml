        <!-- RIGHT SIDE -->

        <div class="right-dashboard">


            <!-- Revenue -->

            <div class="dashboard-card revenue-card">

                <div class="card-header">

                    <div>

                        <h3>
                            Revenue Overview
                        </h3>

                        <h2>
                            ₹25,68,450
                        </h2>

                        <span class="revenue-growth">
                            ↑ 22.4% from last month
                        </span>

                    </div>

                    <select>

                        <option>
