@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

}


<div class="dashboard">


    <!-- =========================================
         PAGE HEADER
    ========================================== -->

    <div class="dashboard-header">

        <div>

            <h1>
                Dashboard
            </h1>

            <p>
                Welcome back, Admin! 👋
            </p>

        </div>


        <div class="date-filter">

            <i class="bi bi-calendar3"></i>

            <span>
                01 May, 2026 - 31 May, 2026
            </span>

            <i class="bi bi-chevron-down"></i>

        </div>

    </div>


    <!-- =========================================
         STATISTICS
    ========================================== -->

    <div class="stats-grid">


        <!-- Transactions -->

        <div class="stat-card blue-card">

            <div class="stat-top">

                <div class="stat-icon">

                    <i class="bi bi-arrow-left-right"></i>

                </div>

                <div class="stat-menu">
                    <i class="bi bi-three-dots"></i>
                </div>

            </div>

            <div class="stat-content">

                <span>
                    Total Transactions
                </span>

                <h2 class="counter">
                    12458
                </h2>

                <div class="stat-growth positive">

                    <i class="bi bi-arrow-up"></i>

                    18.6%

                    <small>
                        from last month
                    </small>

                </div>

            </div>

            <div class="mini-chart blue-chart">

                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>


        <!-- Revenue -->

        <div class="stat-card green-card">

            <div class="stat-top">

                <div class="stat-icon">

                    <i class="bi bi-wallet2"></i>

                </div>

                <div class="stat-menu">
                    <i class="bi bi-three-dots"></i>
                </div>

            </div>

            <div class="stat-content">

                <span>
                    Total Revenue
                </span>

                <h2>
                    ₹25,68,450
                </h2>

                <div class="stat-growth positive">

                    <i class="bi bi-arrow-up"></i>

                    22.4%

                    <small>
                        from last month
                    </small>

                </div>

            </div>

            <div class="mini-chart green-chart">

                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>


        <!-- Users -->

        <div class="stat-card purple-card">

            <div class="stat-top">

                <div class="stat-icon">

                    <i class="bi bi-people"></i>

                </div>

                <div class="stat-menu">
                    <i class="bi bi-three-dots"></i>
                </div>

            </div>

            <div class="stat-content">

                <span>
                    Total Users
                </span>

                <h2>
                    8,952
                </h2>

                <div class="stat-growth positive">

                    <i class="bi bi-arrow-up"></i>

                    15.3%

                    <small>
                        from last month
                    </small>

                </div>

            </div>

            <div class="mini-chart purple-chart">

                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>


        <!-- Commission -->

        <div class="stat-card orange-card">

            <div class="stat-top">

                <div class="stat-icon">

                    <i class="bi bi-percent"></i>

                </div>

                <div class="stat-menu">
                    <i class="bi bi-three-dots"></i>
                </div>

            </div>

            <div class="stat-content">

                <span>
                    Total Commission
                </span>

                <h2>
                    ₹1,25,850
                </h2>

                <div class="stat-growth positive">

                    <i class="bi bi-arrow-up"></i>

                    19.8%

                    <small>
                        from last month
                    </small>

                </div>

            </div>

            <div class="mini-chart orange-chart">

                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>

    </div>


    <!-- =========================================
         MIDDLE SECTION
    ========================================== -->

    <div class="dashboard-grid">


        <!-- Transaction Overview -->

        <div class="dashboard-card transaction-chart-card">

            <div class="card-header">

                <div>

                    <h3>
                        Transaction Overview
                    </h3>

                    <div class="chart-legends">

                        <span>
                            <i class="legend green"></i>
                            Successful
                        </span>

                        <span>
                            <i class="legend orange"></i>
                            Pending
                        </span>

                        <span>
                            <i class="legend red"></i>
                            Failed
                        </span>

                    </div>

                </div>


                <select>

                    <option>
                        This Month
                    </option>

                    <option>
                        Last Month
                    </option>

                    <option>
                        This Year
                    </option>

                </select>

            </div>


            <div class="fake-line-chart">

                <div class="chart-lines">

                    <div class="line line-green"></div>

                    <div class="line line-orange"></div>

                    <div class="line line-red"></div>

                </div>


                <div class="chart-grid-lines">

                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>

                </div>


                <div class="chart-labels">

                    <span>01 May</span>
                    <span>06 May</span>
                    <span>11 May</span>
                    <span>16 May</span>
                    <span>21 May</span>
                    <span>26 May</span>
                    <span>31 May</span>

                </div>

            </div>

        </div>


        <!-- Transaction Type -->

        <div class="dashboard-card transaction-type-card">

            <div class="card-header">

                <h3>
                    Transactions by Type
                </h3>

                <select>

                    <option>
                        This Month
                    </option>

                </select>

            </div>


            <div class="donut-section">

                <div class="donut-chart">

                    <div class="donut-center">

                        <strong>
                            12,458
                        </strong>

                        <small>
                            Total
                        </small>

                    </div>

                </div>


                <div class="type-list">

                    <div>

                        <span>
                            <i class="type-dot blue"></i>
                            Mobile Recharge
                        </span>

                        <b>35%</b>

                    </div>

                    <div>

                        <span>
                            <i class="type-dot green"></i>
                            DTH Recharge
                        </span>

                        <b>25%</b>

                    </div>

                    <div>

                        <span>
                            <i class="type-dot orange"></i>
                            Bill Payments
                        </span>

                        <b>20%</b>

                    </div>

                    <div>

                        <span>
                            <i class="type-dot purple"></i>
                            Money Transfer
                        </span>

                        <b>10%</b>

                    </div>

                    <div>

                        <span>
                            <i class="type-dot pink"></i>
                            Others
                        </span>

                        <b>10%</b>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->

        <div class="dashboard-card quick-actions-card">

            <div class="card-header">

                <h3>
                    Quick Actions
                </h3>

            </div>


            <div class="quick-actions">

                <button>
                    <i class="bi bi-wallet-fill"></i>
                    <span>Add Money</span>
                </button>

                <button>
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Money Transfer</span>
                </button>

                <button>
                    <i class="bi bi-phone"></i>
                    <span>Mobile Recharge</span>
                </button>

                <button>
                    <i class="bi bi-broadcast-pin"></i>
                    <span>DTH Recharge</span>
                </button>

                <button>
                    <i class="bi bi-receipt"></i>
                    <span>Bill Payment</span>
                </button>

                <button>
                    <i class="bi bi-bar-chart"></i>
                    <span>View Reports</span>
                </button>

            </div>

        </div>

    </div>


    <!-- =========================================
         BOTTOM SECTION
    ========================================== -->

