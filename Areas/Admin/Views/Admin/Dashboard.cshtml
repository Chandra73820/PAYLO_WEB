@section Styles {

    <style>

        /* =========================================================
           DASHBOARD
        ========================================================= */

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }


            .dashboard-header h1 {
                font-size: 25px;
                font-weight: 800;
                margin-bottom: 6px;
            }


            .dashboard-header p {
                color: #7a8799;
                font-size: 12px;
            }


        .date-filter {
            display: flex;
            align-items: center;
            gap: 9px;
            background: white;
            border: 1px solid #e5eaf1;
            padding: 11px 15px;
            border-radius: 9px;
            font-size: 11px;
            color: #4c5d76;
            cursor: pointer;
        }


        /* =========================================================
           STATS
        ========================================================= */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 18px;
        }


        .stat-card {
            min-height: 145px;
            background: white;
            border-radius: 14px;
            padding: 18px;
            position: relative;
            overflow: hidden;
            border: 1px solid #edf1f6;
            box-shadow: 0 5px 20px rgba(20,42,80,.04);
            transition: transform .3s ease, box-shadow .3s ease;
            animation: fadeUp .5s ease both;
        }


            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 14px 35px rgba(20,42,80,.10);
            }


        .stat-top {
            display: flex;
            justify-content: space-between;
        }


        .stat-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            color: white;
            font-size: 20px;
        }


        .blue-card .stat-icon {
            background: linear-gradient(135deg,#0879ed,#005ac9);
        }


        .green-card .stat-icon {
            background: linear-gradient(135deg,#19b85b,#00963e);
        }


        .purple-card .stat-icon {
            background: linear-gradient(135deg,#8a55ed,#6336c7);
        }


        .orange-card .stat-icon {
            background: linear-gradient(135deg,#ffb300,#f27c00);
        }


        .stat-menu {
            color: #aab4c2;
        }


        .stat-content {
            margin-top: 12px;
        }


            .stat-content > span {
                color: #758297;
                font-size: 11px;
            }


            .stat-content h2 {
                margin-top: 4px;
                font-size: 23px;
                font-weight: 800;
            }


        .stat-growth {
            margin-top: 6px;
            font-size: 10px;
            font-weight: 700;
        }


            .stat-growth small {
                color: #8995a7;
                font-weight: 400;
                margin-left: 3px;
            }


        .positive {
            color: #12a150;
        }


        /* =========================================================
           MINI CHART
        ========================================================= */

        .mini-chart {
            position: absolute;
            bottom: 15px;
            right: 15px;
            width: 75px;
            height: 40px;
            display: flex;
            align-items: flex-end;
            gap: 4px;
        }


            .mini-chart span {
                width: 7px;
                border-radius: 5px;
                animation: chartGrow .8s ease both;
            }


                .mini-chart span:nth-child(1) {
                    height: 25%;
                }

                .mini-chart span:nth-child(2) {
                    height: 50%;
                }

                .mini-chart span:nth-child(3) {
                    height: 35%;
                }

                .mini-chart span:nth-child(4) {
                    height: 70%;
                }

                .mini-chart span:nth-child(5) {
                    height: 48%;
                }

                .mini-chart span:nth-child(6) {
                    height: 85%;
                }

                .mini-chart span:nth-child(7) {
                    height: 65%;
                }


        .blue-chart span {
            background: #147bea;
        }


        .green-chart span {
            background: #15ad55;
        }


        .purple-chart span {
            background: #8151e6;
        }


        .orange-chart span {
            background: #f69a00;
        }


        /* =========================================================
           DASHBOARD GRID
        ========================================================= */

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr .75fr;
            gap: 16px;
            margin-bottom: 18px;
        }


        .dashboard-card {
            background: white;
            border: 1px solid #edf1f6;
            border-radius: 14px;
            padding: 18px;
            box-shadow: 0 5px 20px rgba(20,42,80,.035);
            animation: fadeUp .6s ease both;
        }


        .card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 18px;
        }


            .card-header h3 {
                font-size: 14px;
                font-weight: 700;
            }


            .card-header select {
                border: 1px solid #e5eaf1;
                background: white;
                padding: 7px 10px;
                border-radius: 7px;
                font-size: 10px;
                outline: none;
            }


            .card-header a {
                color: #0066d6;
                font-size: 10px;
                text-decoration: none;
                font-weight: 600;
            }


        /* =========================================================
           LEGENDS
        ========================================================= */

        .chart-legends {
            display: flex;
            gap: 15px;
            margin-top: 12px;
        }


            .chart-legends span {
                font-size: 9px;
                color: #78869a;
            }


        .legend {
            width: 8px;
            height: 8px;
            display: inline-block;
            border-radius: 2px;
            margin-right: 4px;
        }


            .legend.green {
                background: #13ae55;
            }


            .legend.orange {
                background: #f7a300;
            }


            .legend.red {
                background: #ef4444;
            }


        /* =========================================================
           LINE CHART
        ========================================================= */

        .fake-line-chart {
            height: 230px;
            position: relative;
            padding-bottom: 30px;
        }


        .chart-grid-lines {
            position: absolute;
            inset: 10px 0 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }


            .chart-grid-lines span {
                border-top: 1px dashed #edf0f5;
                width: 100%;
            }


        .chart-lines {
            position: absolute;
            inset: 10px 0 30px;
            overflow: hidden;
        }


        .line {
            position: absolute;
            width: 110%;
            height: 90px;
            border-radius: 50%;
            transform: rotate(-7deg);
        }


        .line-green {
            top: 40px;
            left: -5%;
            border-top: 3px solid #16aa54;
            box-shadow: 0 -15px 20px rgba(22,170,84,.05);
        }


        .line-orange {
            top: 90px;
            left: -5%;
            border-top: 3px solid #f5a000;
        }


        .line-red {
            top: 135px;
            left: -5%;
            border-top: 3px solid #ef4444;
        }


        .chart-labels {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            color: #8793a4;
            font-size: 8px;
        }


        /* =========================================================
           DONUT
        ========================================================= */

        .donut-section {
            display: flex;
            align-items: center;
            gap: 22px;
        }


        .donut-chart {
            width: 150px;
            height: 150px;
            flex-shrink: 0;
            border-radius: 50%;
            background: conic-gradient( #0878e8 0 35%, #18ad58 35% 60%, #f5a000 60% 80%, #8151e6 80% 90%, #ec4f91 90% 100% );
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: rotateIn 1s ease;
        }


            .donut-chart::before {
                content: "";
                position: absolute;
                width: 92px;
                height: 92px;
                background: white;
                border-radius: 50%;
            }


        .donut-center {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
        }


            .donut-center strong {
